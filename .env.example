# ---- Auth (Better Auth) ----

# Secret used by Better Auth (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-long-random-value

# Public origin of this app (no trailing slash). Used for links, OAuth, and auth.
# Local: http://localhost:3200
APP_URL=http://localhost:3200

# Optional: only set if Better Auth must use a different origin than APP_URL.
# Defaults to APP_URL (then Vercel URL / localhost).
# BETTER_AUTH_URL=

# Google OAuth (Cloud Console → Web client)
# Use a *separate* OAuth app for local vs production. Do not add localhost
# redirect URIs to the production client.
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings → Developer settings → OAuth Apps)
# Same rule: separate GitHub OAuth App for local vs production.
# Authorization callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional passkey relying-party id (defaults to hostname of APP_URL)
# PASSKEY_RP_ID=localhost

# App Store reviewer-only email account. The password is needed only while
# running `npm run app-review:provision`; do not add it to Vercel.
# APP_REVIEW_DEMO_EMAIL=app-review@example.com
# APP_REVIEW_DEMO_PASSWORD=
# APP_REVIEW_DEMO_NAME=App Review

# ---- Database (Postgres) ----

# Postgres connection string.
#   Local dev : docker compose -> postgres://penopta:penopta@localhost:5434/penopta
#   Production: Neon (Vercel Marketplace sets DATABASE_URL; ignore the other aliases)
# Driver is chosen from the host: Neon → neon-http, else node-postgres.
# Override with DB_DRIVER=pg|neon if needed.
DATABASE_URL=postgres://penopta:penopta@localhost:5434/penopta

# Optional override for the Penopta Sync download button.
# Leave unset — the button uses `downloadUrl` in public/downloads/Penopta-Sync.json
# (a GitHub Release asset URL written by the Mac repo’s `bash scripts/publish.sh`).
# Only set if you intentionally host the DMG somewhere else.
# PENOPTA_SYNC_DOWNLOAD_URL=

# Optional override for the Linux sync GitHub repo (default sshadmand/penopta-linux-sync).
# PENOPTA_LINUX_SYNC_REPO=owner/penopta-linux-sync
# Mac publish reads SENTRY_* from .env.production (same file as db:migrate:prod).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=penopta
# SENTRY_PROJECT=mac-app

# ---- Email (Azure Communication Services) ----
# Used for org invite notifications.
# AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=endpoint=https://….communication.azure.com/;accesskey=…
# Optional sender override (defaults to EMAIL_FROM, then DoNotReply@node-mailer.com)
# EMAIL_FROM=DoNotReply@node-mailer.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@node-mailer.com

# ---- AI (BYOK) ----
# Optional dedicated secret for encrypting org LLM API keys at rest.
# Defaults to BETTER_AUTH_SECRET when unset.
# LLM_CREDENTIALS_SECRET=

# ---- Cron (Vercel) ----
# Bearer token Vercel sends to /api/cron/* routes.
# Generate with: openssl rand -base64 32
# Also set this in the Vercel project env (Production).
# CRON_SECRET=
