# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local Better Auth cutover checklist (emails + portal ids)
/scripts/.prod-user-map.json

# Maintainer-only plans and hosted-site notes (see docs/private/README.md)
/docs/private/**
!/docs/private/README.md
# Do not use a public stand-in for private plans (see docs/opensource-safety.md)
/docs/plans/

# Mac installer is a GitHub Release asset, not a git file. Manifest JSON stays.
/public/downloads/*.dmg
/public/downloads/*.zip

__pycache__/
*.py[cod]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
