{
  "name": "penopta",
  "version": "0.1.13",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx src/lib/db/seed.ts",
    "db:wipe": "dotenv -e .env.local -- tsx src/lib/db/wipe.ts",
    "app-review:provision": "dotenv -e .env.local -- tsx scripts/provision-app-review-user.ts",
    "app-review:provision:prod": "dotenv -e .env.production -- tsx scripts/provision-app-review-user.ts",
    "app-review:seed:prod": "dotenv -e .env.production -- tsx scripts/seed-app-review-demo.ts",
    "plugins:publish": "tsx scripts/publish-openai-plugin.ts",
    "plugins:publish:claude": "tsx scripts/publish-claude-plugin.ts",
    "plugins:sync:claude": "bash scripts/sync-claude-plugin-repo.sh",
    "plugins:add": "codex plugin marketplace add .",
    "version:bump": "npm version patch --no-git-tag-version --ignore-scripts",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.37",
    "@ai-sdk/google": "^4.0.41",
    "@ai-sdk/openai": "^4.0.38",
    "@azure/communication-email": "^1.1.0",
    "@better-auth/passkey": "^1.7.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.60",
    "better-auth": "^1.7.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.27.0",
    "mcp-handler": "^2.0.1",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
